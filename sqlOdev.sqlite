## 1. SQL CRUD İşlemleri ##

//USER TABLOSU OLUŞTURMA


PRAGMA foreign_keys = ON;

CREATE TABLE IF NOT EXISTS users (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    full_name TEXT NOT NULL,
    email TEXT UNIQUE NOT NULL,
    birthday TEXT NOT NULL 
);



// 1.Tabloya 3 adet kullanıcı ekleyin.


INSERT INTO users (full_name, email, birthday) 
VALUES 
    ('Meltem Demir', 'meltemDemir@example.com', '1996-10-30'),
    ('Ayşe Mavi', 'ayse@gmail.com', '1995-10-22'),
    ('Selin Sezer', 'selin@example.com', '1988-12-03');
    ('Fatma Ak', 'fatma_ak@gmail.com', '1998-01-03');

/*--ÇIKTI: Sonuç: 4 rows inserted. */



// 2.Kullanıcıları listeleyin.

SELECT * FROM users;

/*--ÇIKTI: id    fullname          email                      birthday 
            1   Meltem Demir    meltemDemir@example.com      1994-10-30
            2   Ayşe Mavi       ayse@gmail.com               1995-10-22
            3   Selin Sezer     selin@example.com            1988-12-03
            4   Fatma Ak        fatma_ak@gmail.com           1998-01-03

*/ 



// 3.Kullanıcılardan birinin email adresini güncelleyin. 

